OPENAI_API_KEY=
REDIS_URL=redis://redis:6379/0
APP_ENV=dev
LOG_LEVEL=info
CORS_ORIGINS=*
PUBLIC_BASE_URL=ws://localhost:8000
# Host port the api container binds to. Default 8000 for local dev.
# In prod behind Cloudflare set to 80 (CF Free plan only allows 80/443).
API_HOST_PORT=8000

# S1 Day 8 cost logger / daily cap. Pricing values are placeholders;
# verify against the OpenAI Realtime GA rate sheet before the pilot.
# Set DAILY_USD_CAP=0 to disable the cap (dev / load-test mode).
DAILY_USD_CAP=5.0
USD_PER_AUDIO_MINUTE_INPUT=0.10
USD_PER_1K_TOKENS_IN=0.005
USD_PER_1K_TOKENS_OUT=0.020
