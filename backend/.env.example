OPENAI_API_KEY=
REDIS_URL=redis://redis:6379/0
APP_ENV=dev
LOG_LEVEL=info
CORS_ORIGINS=*
PUBLIC_BASE_URL=ws://localhost:8000
# Host port the api container binds to. Default 8000 for local dev.
# In prod behind Cloudflare set to 80 (CF Free plan only allows 80/443).
API_HOST_PORT=8000

# S1 Day 8 cost logger / daily cap. Per-million-token rates for the
# gpt-realtime GA model (captured 2026-05-22). Set DAILY_USD_CAP=0 to
# disable the cap (dev / load-test mode).
DAILY_USD_CAP=5.0
USD_PER_M_AUDIO_INPUT=32.0
USD_PER_M_TEXT_INPUT=4.0
USD_PER_M_AUDIO_CACHED_INPUT=0.40
USD_PER_M_TEXT_CACHED_INPUT=0.40
USD_PER_M_TEXT_OUTPUT=16.0
USD_PER_M_AUDIO_OUTPUT=64.0
