.pub/
build/
.fvm/
.fvmrc
android/.gradle/
android/local.properties
android/key.properties
ios/Pods/
ios/.symlinks/

# Python (tools/)
__pycache__/
*.pyc

# Logs
*.log

# Claude local overrides (per-machine permissions etc. should not be shared)
.claude/settings.local.json
